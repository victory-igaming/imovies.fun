# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_TEST_AD_MODE=false

# ── TMDB ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key

# ── CMS (Laravel backend) ────────────────────────────────────────────────────
NEXT_PUBLIC_CMS_URL=http://localhost:8000
NEXT_PUBLIC_CMS_TOKEN_KEY=your_cms_bearer_token
CMS_URL=http://localhost:8000
CMS_TOKEN_KEY=your_cms_bearer_token

# ── Ads ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID=pub-xxxxxxxx
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxx

# ── Player feature flags ─────────────────────────────────────────────────────
NEXT_PUBLIC_NEXT_SOURCE_BTN=true
NEXT_PUBLIC_QUALITY_SELECTOR=true

# ── Residential proxy pool (required for /api/stream on VPS) ─────────────────
# IMPORTANT: use ONE line comma-separated — dotenv does NOT read multi-line values.
# Webshare format: host:port:user:pass
PROXY_URL=http://user:pass@host:port
PROXY_LIST=host1:port1:user:pass,host2:port2:user:pass,host3:port3:user:pass

# ── Playwright (Linux VPS only) ──────────────────────────────────────────────
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/lib64/chromium-browser/chromium-browser
